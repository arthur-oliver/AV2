# Copie este arquivo para ".env" e ajuste os valores.
#   Windows (cmd):  copy .env.example .env
#   Linux/Ubuntu:   cp .env.example .env

# Conexão MySQL: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/greencode"

# Servidor HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Autenticação JWT (JWT_SECRET precisa ter 32 ou mais caracteres)
JWT_SECRET="troque-por-uma-frase-longa-e-aleatoria-com-32-ou-mais-caracteres"
JWT_EXPIRES_IN=1h
